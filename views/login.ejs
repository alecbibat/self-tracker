<%- include('partials/head', { title: title, bodyClass: 'auth-page' }) %>
<main class="auth">
  <div class="auth__card card card--pad-lg">
    <h1 class="center">Welcome back</h1>
    <p class="center muted">Log in to your private tracker.</p>
    <% if (error) { %>
      <div class="auth__error"><%= error %></div>
    <% } %>
    <form method="post" action="/login" class="stack">
      <input type="hidden" name="next" value="<%= next %>" />
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" autofocus required />
      </div>
      <button type="submit" class="btn btn--lg btn--block">Log in</button>
    </form>
    <p class="center mt-2"><a href="/" class="muted text-sm">← Back to site</a></p>
  </div>
</main>
<style>
  .auth-page { background: radial-gradient(1000px 540px at 50% -12%, rgba(196, 162, 101, 0.10), transparent 62%), var(--bg); }
  .auth { display: flex; align-items: center; justify-content: center; padding: 60px 20px; min-height: 80vh; }
  .auth__card { width: 100%; max-width: 390px; }
  .auth__error { background: rgba(198,90,80,0.12); border: 1px solid var(--danger); color: #e8a49c; padding: 10px 12px; border-radius: var(--radius-sm); font-size: 0.9rem; margin-bottom: 14px; }
</style>
<%- include('partials/footer', {}) %>
