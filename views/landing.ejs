<%- include('partials/head', { title: title, css: ['public'], head: '' }) %>
<%- include('partials/public-nav') %>

<%
  // Thin-stroke SVG icons for the landing link buttons. Server-defined
  // constants (never user input), rendered unescaped below.
  var SVG_OPEN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">';
  var ICONS = {
    file: SVG_OPEN + '<path d="M13.5 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V8z"/><path d="M13.5 3v5h5M9.2 13h5.6M9.2 16.5h5.6"/></svg>',
    star: SVG_OPEN + '<path d="M12 3.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z"/></svg>',
    grid: SVG_OPEN + '<rect x="4" y="4" width="6.6" height="6.6" rx="1"/><rect x="13.4" y="4" width="6.6" height="6.6" rx="1"/><rect x="4" y="13.4" width="6.6" height="6.6" rx="1"/><rect x="13.4" y="13.4" width="6.6" height="6.6" rx="1"/></svg>',
    link: SVG_OPEN + '<path d="M7 17L17 7M9.5 7H17v7.5"/></svg>',
    mail: SVG_OPEN + '<rect x="3.5" y="5.5" width="17" height="13" rx="1.6"/><path d="M4.5 7l7.5 6 7.5-6"/></svg>',
    github: SVG_OPEN + '<circle cx="6.5" cy="6" r="2.3"/><circle cx="6.5" cy="18" r="2.3"/><circle cx="17.5" cy="8" r="2.3"/><path d="M6.5 8.3v7.4M17.5 10.3c0 3.2-3 4-6 4.6a6 6 0 0 0-3 1.4"/></svg>',
    globe: SVG_OPEN + '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.3 3.9 5.2 3.9 8.5s-1.3 6.2-3.9 8.5c-2.6-2.3-3.9-5.2-3.9-8.5s1.3-6.2 3.9-8.5z"/></svg>',
    book: SVG_OPEN + '<path d="M12 6.2C10.5 4.9 8.6 4.3 6 4.3c-1 0-1.9.1-2.5.3v14.2c.6-.2 1.5-.3 2.5-.3 2.6 0 4.5.6 6 1.9 1.5-1.3 3.4-1.9 6-1.9 1 0 1.9.1 2.5.3V4.6c-.6-.2-1.5-.3-2.5-.3-2.6 0-4.5.6-6 1.9z"/><path d="M12 6.2v14.2"/></svg>',
    code: SVG_OPEN + '<path d="M8.5 7.5L4 12l4.5 4.5M15.5 7.5L20 12l-4.5 4.5"/></svg>',
    heart: SVG_OPEN + '<path d="M12 20s-7.5-4.6-7.5-10a4.3 4.3 0 0 1 7.5-2.9A4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/></svg>'
  };
%>

<main class="hero hero--<%= landing.background_type || 'gradient' %>">
  <% if ((landing.background_type === 'image') && backgroundSrc) { %>
    <div class="hero__bg hero__bg--image" style="background-image: url('<%= backgroundSrc %>');" aria-hidden="true"></div>
  <% } else if ((landing.background_type === 'video') && backgroundSrc) { %>
    <video class="hero__bg hero__bg--video" autoplay muted loop playsinline aria-hidden="true">
      <source src="<%= backgroundSrc %>" />
    </video>
  <% } else { %>
    <div class="hero__bg hero__bg--gradient" aria-hidden="true"></div>
  <% } %>

  <div class="hero__overlay" aria-hidden="true" style="opacity: <%= overlay %>;"></div>

  <div class="hero__content">
    <div class="container hero__inner">
      <span class="hero__rule" aria-hidden="true"></span>
      <% if (landing.title) { %>
        <h1 class="hero__title"><%= landing.title %></h1>
      <% } %>
      <% if (landing.subtitle) { %>
        <p class="hero__subtitle"><%= landing.subtitle %></p>
      <% } %>

      <% if (links && links.length) { %>
        <div class="hero__links">
          <% links.forEach(function (lnk) { %>
            <% if (lnk && lnk.label && lnk.href) {
                 var external = /^https?:\/\//i.test(lnk.href);
                 var glyph = lnk.icon && ICONS[lnk.icon] ? ICONS[lnk.icon] : '';
            %>
              <a
                class="btn btn--lg hero__link"
                href="<%= lnk.href %>"
                <% if (external) { %>target="_blank" rel="noopener noreferrer"<% } %>
              >
                <% if (glyph) { %><span class="hero__link-icon" aria-hidden="true"><%- glyph %></span><% } %>
                <span><%= lnk.label %></span>
              </a>
            <% } %>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <a class="hero__scroll" href="/projects" aria-label="See projects">
    <span class="hero__scroll-chevron" aria-hidden="true"></span>
  </a>
</main>

<%- include('partials/footer', { js: [] }) %>
