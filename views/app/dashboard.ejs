<%- include('../partials/head', { title: title, css: [] }) %>
<%- include('../partials/app-nav', { active: 'dashboard' }) %>
<main class="page">
  <div class="container">
    <div class="page-header">
      <div>
        <h1>Dashboard</h1>
        <p class="subtitle">Your private space. Track habits, nutrition, and manage your site.</p>
      </div>
    </div>

    <section class="grid grid--2" id="today-glance">
      <div class="card">
        <div class="card__title"><h3>Habits today</h3><a href="/app/habits" class="text-sm">Open →</a></div>
        <div id="glance-habits" class="muted text-sm">Loading…</div>
      </div>
      <div class="card">
        <div class="card__title"><h3>Nutrition today</h3><a href="/app/nutrition" class="text-sm">Open →</a></div>
        <div id="glance-nutrition" class="muted text-sm">Loading…</div>
      </div>
    </section>

    <h2 class="mt-3 mb-2">Jump to</h2>
    <section class="grid grid--3">
      <a class="card nav-card" href="/app/habits">
        <span class="icon-chip" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 9.5h17M8 2.8v4M16 2.8v4"/><path d="M8.5 14.5l2.3 2.3 4.7-4.6"/></svg>
        </span>
        <h3>Habit Tracker</h3>
        <p class="muted text-sm">Add habits, track yes/no or quantities, and watch your streaks.</p>
      </a>
      <a class="card nav-card" href="/app/nutrition">
        <span class="icon-chip" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5c.5 2.7-1.3 4.3-2.5 5.7-1.3 1.5-2.2 3-2.2 4.9a6.7 6.7 0 0 0 13.4 0c0-2.2-.9-4-2.1-5.6C17 6.7 14.6 5.4 12 3.5z"/><path d="M12 20.5a3 3 0 0 1-3-3c0-1.7 1.5-2.5 3-3.8 1.5 1.3 3 2.1 3 3.8a3 3 0 0 1-3 3z"/></svg>
        </span>
        <h3>Nutrition &amp; Weight</h3>
        <p class="muted text-sm">Log meals and weight, set goals, and view weekly / monthly trends.</p>
      </a>
      <a class="card nav-card" href="/app/admin">
        <span class="icon-chip" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h8M16.5 7H20M4 17h3.5M12 17h8M14.5 4.6v4.8M7.5 14.6v4.8"/></svg>
        </span>
        <h3>Site Admin</h3>
        <p class="muted text-sm">Edit your landing page, manage projects, and upload photos.</p>
      </a>
    </section>
  </div>
</main>
<style>
  .nav-card { display: block; transition: transform .12s ease, border-color .12s ease; }
  .nav-card:hover { transform: translateY(-2px); border-color: var(--text-faint); text-decoration: none; }
  .nav-card:hover .icon-chip { color: var(--brand); border-color: var(--brand); }
  .nav-card .icon-chip { margin-bottom: 14px; }
  .nav-card h3 { margin-bottom: 6px; font-family: var(--font-display); font-weight: 500; font-size: 1.25rem; }
</style>
<%- include('../partials/footer', { js: ['dashboard'] }) %>
