# Copy this file to ".env" for local development and fill in the values.

# Postgres connection string.
# Local example: postgres://postgres:postgres@localhost:5432/self_tracker
# On Heroku this is provided automatically by the Heroku Postgres add-on.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/self_tracker

# The single password used to log in to the private section.
# Choose something strong. Required in every environment.
ADMIN_PASSWORD=change-me-please

# Secret used to sign session cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Port the server listens on (Heroku sets this automatically).
PORT=3000

# Set to "production" on Heroku. Leave unset (or "development") locally.
NODE_ENV=development
